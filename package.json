{
  "name": "mend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file=.env --import tsx/esm server/index.ts",
    "start": "node dist-server/server/index.js",
    "build": "tsc -b --clean && tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:lint": "i18next-cli lint --config i18next.config.ts",
    "i18n:status": "i18next-cli status --config i18next.config.ts",
    "i18n:check": "npm run i18n:lint && npm run i18n:status",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "express": "5.1.0",
    "express-rate-limit": "8.6.1",
    "file-type": "^22.0.1",
    "helmet": "8.1.0",
    "i18next": "^26.3.6",
    "lucide-react": "0.468.0",
    "openai": "5.12.2",
    "pino": "9.9.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "7.18.2",
    "sharp": "^0.35.3",
    "tus-js-client": "^4.3.1",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.62.1",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "i18next-cli": "^1.67.7",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "supertest": "7.1.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
