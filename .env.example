VITE_SUPABASE_URL=https://uwhugsimhtjtrnuotuki.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MEND_API_URL=http://localhost:8787
VITE_MEND_DEMO_MODE=0
# Local-only operator preview; never enable this in a production build.
VITE_MEND_LOCAL_OPERATOR_MODE=0
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WHATSMIAU_BASE_URL=https://api.whatsmiau.dev/v2
WHATSMIAU_API_KEY=
WHATSMIAU_WEBHOOK_SECRET=
# Stable public HTTPS receiver for inbound Whatsmiau events. In production,
# use the deployed Supabase Edge Function URL; localhost cannot receive webhooks.
WHATSMIAU_WEBHOOK_URL=
# Public URL used in invitation/recovery links and OAuth callbacks.
APP_BASE_URL=http://localhost:5173
# Server-only Google OAuth. Leave blank until the Google OAuth consent screen
# and redirect URI are configured; the UI will report that configuration gap.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/google/connections/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Used by the local Supabase Auth Google provider. The hosted provider is
# configured separately in the Supabase dashboard or Management API.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
SUPPORT_AI_MODEL=gpt-5-mini
MEND_PROCESS_ROLE=control
MEND_AGENT_WORKSPACE_ROOT=/workspace/runs
MEND_AGENT_CREDENTIAL_ENCRYPTION_KEY=
MEND_AGENT_MAX_RUNTIME_SECONDS=1200
MEND_AGENT_MAX_CONCURRENCY=1
MEND_GITHUB_ACTIONS_ENABLED=0
# Optional absolute executable/JavaScript entrypoints. Leave blank to use the
# known CLI name on Unix or the standard global npm installation on Windows.
# Shell shims (.cmd/.bat/.ps1) are intentionally rejected.
MEND_OPENAI_CLI_PATH=
MEND_ANTHROPIC_CLI_PATH=
MEND_GOOGLE_CLI_PATH=
MEND_VERBOO_CLI_PATH=
# Continuation workers mark queued/running Agent runs stale after this window
# if the executor process died without a terminal checkpoint.
MEND_AGENT_RUN_STALE_MS=1800000
# GitHub App control plane. Prefer the base64 form for multiline PEM values.
MEND_GITHUB_APP_ID=
MEND_GITHUB_APP_SLUG=
MEND_GITHUB_APP_PRIVATE_KEY_BASE64=
MEND_GITHUB_WEBHOOK_SECRET=
MEND_GITHUB_SETUP_STATE_SECRET=
MEND_GITHUB_API_URL=https://api.github.com
MEND_GITHUB_API_VERSION=2026-03-10
# Optional release gates. Agent publication still requires explicit approval.
DOKPLOY_API_URL=
DOKPLOY_API_KEY=
DOKPLOY_APPLICATION_ID=
# Credential-free HTTPS endpoint checked after deploy. Origins are comma-separated.
MEND_DEPLOYMENT_HEALTH_URL=
MEND_HEALTHCHECK_ALLOWED_ORIGINS=
PORT=8787
MEND_API_TOKEN=
# Allows the local Vite app to exercise the safe WhatsApp connection endpoints
# without putting the provider key in the browser. Keep disabled in production.
MEND_DEV_MODE=1
MEND_WORKER_POLL_MS=2000
# Native media pipeline. Set to 0 only while rolling back to legacy base64/URL sending.
MEND_MEDIA_PIPELINE_V2=1
MEDIA_PROCESS_TIMEOUT_MS=120000
MEDIA_MAX_BYTES=104857600
